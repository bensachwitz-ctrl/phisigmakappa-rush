<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications: NOT declared. The shipped bundled shell does not use
	     push (the push Capacitor plugin is unused in mobile-shell/index.html), so
	     the push entitlement was removed to match actual behavior and avoid an
	     Apple Guideline 2.3.1 unused-capability flag. Re-add the push entitlement
	     here (and the push background mode in Info.plist) together if a future
	     build actually wires push. -->

	<!-- Universal links: tapping https://greekstack.com/app?chapter=… (or the
	     vercel host) opens the app straight into that chapter instead of Safari.
	     Requires an apple-app-site-association file served at the domain root
	     (see IOS-RELEASE.md). applinks is inert until that file is published, so
	     it is safe to ship now. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:greekstack.com</string>
		<string>applinks:www.greekstack.com</string>
		<string>applinks:greekstack.vercel.app</string>
	</array>
</dict>
</plist>
