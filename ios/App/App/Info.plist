<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Greek Stack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone-only app (TARGETED_DEVICE_FAMILY=1): portrait only. The iPad
	     orientation array was removed — the app does not target iPad. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- ── Export compliance ──────────────────────────────────────────────────
	     The app uses only standard HTTPS/TLS (exempt encryption), so declare
	     ITSAppUsesNonExemptEncryption=false. Without this key, every TestFlight
	     build stalls awaiting a manual export-compliance answer before it can be
	     distributed to testers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ── Greek Stack: privacy usage strings ─────────────────────────────────
	     The SHIPPED app is the bundled, dependency-free client (mobile-shell/),
	     which does NOT use the camera or the photo library — there is no in-app
	     QR scanner or photo picker in the bundled binary. The camera/photo usage
	     strings were therefore REMOVED so the app declares only the device
	     access it actually exercises (Apple Guideline 2.3 — accurate metadata /
	     no unused permission prompts). If a future build adds a native QR scanner
	     or photo upload, re-add the matching NS*UsageDescription AND wire the
	     capability at the same time. -->

	<!-- ── Deep links: custom URL scheme greekstack:// ────────────────────────
	     Universal (https) links into a chapter are handled via the Associated
	     Domains entitlement (App.entitlements); this custom scheme is the
	     fallback opened via the Capacitor App appUrlOpen listener
	     (lib/native-bridge.ts initDeepLinks → navigateToDeepLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.greekstack.app</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>greekstack</string>
			</array>
		</dict>
	</array>

	<!-- ── Push notifications: NOT used by the shipped bundled shell ──────────
	     The shipped UI is the bundled Capacitor mobile-shell, which does NOT
	     register for or consume push (the push Capacitor plugin is unused in
	     mobile-shell/index.html). Declaring a background mode for it without
	     actually using push is an Apple Guideline 2.3.1 risk ("unused
	     capability"), so the push background mode AND the push entitlement were
	     both removed. Re-add them together (Info.plist + App.entitlements) and
	     wire the plugin if a future build truly uses push. -->

	<!-- ── App Transport Security ─────────────────────────────────────────────
	     We only ever load https origins (greekstack.vercel.app / *.greekstack.com),
	     so leave ATS fully on (no arbitrary-loads exception). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- Status bar: light text on the dark navy chrome; CSS owns safe areas.
	     UIViewControllerBasedStatusBarAppearance is already declared above. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
</dict>
</plist>
