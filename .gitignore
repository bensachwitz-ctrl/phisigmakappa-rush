# capacitor
# The iOS project (ios/App) IS committed so the build is deterministic and the
# native config (Info.plist, icons, entitlements, URL scheme) is version-controlled
# rather than regenerated/patched on every CI run. We only ignore the transient,
# regenerated, or machine-specific bits below (mirrors Capacitor's own ios/.gitignore).
/android
/mobile/

# capacitor iOS — generated / transient (regenerated by `npx cap sync` on CI)
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/App/Podfile.lock
ios/App/DerivedData/
ios/capacitor-cordova-ios-plugins/
ios/**/xcuserdata/
ios/**/.DS_Store

# wave gate logs
*.log
