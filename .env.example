# ─── Database (Postgres) ────────────────────────────────────
# In production use Vercel Postgres / Neon. The Vercel Postgres integration
# auto-injects DATABASE_URL and DIRECT_URL when you connect a database.
# For local dev, you can run a Postgres container or point at a hosted DB.
DATABASE_URL="postgres://user:pass@localhost:5432/phisig"
DIRECT_URL="postgres://user:pass@localhost:5432/phisig"

# ─── Auth ───────────────────────────────────────────────────
# Shared chapter admin login (case-insensitive at the API layer).
# All e-board members use the same credentials — distribute via the
# chapter's password manager. Login matches against ADMIN_USERNAME +
# ADMIN_PASSWORD; ADMIN_SESSION_SECRET signs the auth cookie HMAC.
ADMIN_USERNAME="Phisig"
ADMIN_PASSWORD="changeme-strong-password"
ADMIN_SESSION_SECRET="long-random-string-min-32-chars-aaaaaaaaaaaaaaaa"

# ─── Email (Resend) ─────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# Without these, /api/send-email runs in mock mode (logs only).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="rush@phisig-usc.com"

# ─── SMS (Twilio) ───────────────────────────────────────────
# Get creds at https://console.twilio.com
# Without these, /api/send-sms runs in mock mode (logs only).
TWILIO_ACCOUNT_SID="AC_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+18035551234"

# ─── Payments (Stripe) — dues + alumni donations ────────────
# Get the secret key at https://dashboard.stripe.com/apikeys
# REQUIRED for the dues checkout (/api/dues/checkout) and alumni
# donation checkout (/api/alumni/donate/checkout) to function.
# Without it, getStripe() returns null and the payment buttons
# degrade gracefully (UI shows "payments not configured") — so the
# chapter will NOT be able to collect dues or donations until this
# is set. Use the test key (sk_test_…) until you're ready to go live,
# then swap to the live key (sk_live_…).
# (placeholder shown with an ellipsis so GitHub secret-scanning doesn't
#  flag this example file — paste your real key, which begins sk_test_ or
#  sk_live_, in your deploy env, NOT in this committed file)
STRIPE_SECRET_KEY="sk_test_..."
# NOTE: the Stripe *webhook signing secret* (whsec_…) is NOT an env
# var — each chapter sets it in /admin/settings under Dues, stored as
# the `dues.stripeWebhookSecret` chapter-config value. Create the
# webhook endpoint at https://dashboard.stripe.com/webhooks pointing
# at https://<your-domain>/api/dues/webhook and paste its signing
# secret into admin settings. Until set, the webhook rejects all
# events (400) so no payment can be double-credited.

# ─── Portal sessions (alumni + brother portals) ─────────────
# Signs the HMAC cookie for /portal/* (alumni + brother logins),
# kept separate from the admin session secret so rotating one doesn't
# log out the other. OPTIONAL: if unset, portal auth falls back to
# ADMIN_SESSION_SECRET (and throws at boot in production if neither is
# set). Set a distinct 32+ char value for proper isolation.
PORTAL_SESSION_SECRET="long-random-string-min-32-chars-bbbbbbbbbbbbbbbb"

# ─── Headshot storage (Vercel Blob) ─────────────────────────
# Auto-injected by Vercel when you create a Blob store in Project → Storage.
# Without it, /api/upload-headshot falls back to data URLs (works locally only).
BLOB_READ_WRITE_TOKEN=""

# ─── Auto-enrichment (Tavily) ───────────────────────────────
# Get a free key at https://app.tavily.com (1,000 free searches/mo)
# Without it, /api/admin/enrich returns quick search links instead of auto-pulled data.
TAVILY_API_KEY=""

# ─── Cron auth (W4 scheduled announcements) ─────────────────
# Used by /api/cron/send-scheduled-announcements + /api/cron/reconcile-stripe
# to gate cron-triggered execution. Vercel injects this as the Authorization
# bearer when invoking scheduled crons. Match this value in Vercel project
# settings → Environment Variables → CRON_SECRET. 32+ chars, hex or base64.
CRON_SECRET="long-random-string-min-32-chars-aaaaaaaaaaaaaaaa"

# ─── Google Calendar bridge (W5) ────────────────────────────
# OAuth credentials for /api/google-calendar/* and /api/admin/google-calendar/*.
# Create OAuth 2.0 Client ID at https://console.cloud.google.com → APIs &
# Services → Credentials. Authorized redirect URI must match GOOGLE_REDIRECT_URI.
# Without these, the Google Calendar bridge degrades gracefully (UI shows
# "Connect Google Calendar" but the OAuth flow returns a 503).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://phisigmakappa.vercel.app/api/google-calendar/callback"

# ─── Misc ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://phisigmakappa.vercel.app"
