# ─── Database (Postgres / Neon) ─────────────────────────────
# Vercel's Neon integration auto-injects DATABASE_URL (pooled) + DATABASE_URL_UNPOOLED.
# - DATABASE_URL          → pooled (PgBouncer) connection for normal queries.
# - DATABASE_URL_UNPOOLED → direct (unpooled). REQUIRED: the build's `prisma db
#   push` AND multi-tenant provisioning (CREATE SCHEMA + DDL in /api/onboard) run
#   over this. Running DDL over the pooled URL can hang/fail. If your provider
#   calls the unpooled string "DIRECT_URL", copy that same value into BOTH below.
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:pass@host-direct/db?sslmode=require"
DIRECT_URL="postgres://user:pass@host-direct/db?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────
# Shared chapter admin login. ADMIN_PASSWORD has NO hardcoded default — shared
# login is DISABLED unless you set it (per-chapter DB admins still work).
# ADMIN_SESSION_SECRET signs the admin cookie (per-tenant-derived HMAC) and
# THROWS at boot in production if unset.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme-strong-password"
ADMIN_SESSION_SECRET="long-random-string-min-32-chars-xxxxxxxxxxxxxxxx"

# Cross-subdomain cookie domain. Set to ".yourapex.com" (leading dot) ONLY when
# you have a wildcard custom domain, so the admin cookie set during signup on the
# apex carries to <chapter>.yourapex.com. Leave BLANK for localhost / single-host
# (the new admin then just logs in once on their subdomain).
COOKIE_DOMAIN=""

# ─── Platform operator console (super-admin) ────────────────
# Gates /platform — the operator console to list / suspend / delete chapters,
# SEPARATE from chapter admin (a chapter admin can never reach it). When
# SUPERADMIN_PASSWORD is unset, the console is fully disabled (login → 503).
# SUPERADMIN_SECRET signs the operator cookie (falls back to ADMIN_SESSION_SECRET;
# throws in prod if neither set).
SUPERADMIN_PASSWORD=""
SUPERADMIN_SECRET="long-random-string-min-32-chars-pppppppppppppppp"

# ─── Portal sessions (alumni + brother portals) ─────────────
# Signs /portal/* cookies, kept separate from the admin secret. Falls back to
# ADMIN_SESSION_SECRET if unset (throws in prod if neither is set).
PORTAL_SESSION_SECRET="long-random-string-min-32-chars-yyyyyyyyyyyyyyyy"

# ─── BUNDLED iOS app — API base + native origin ─────────────
# The iOS app now BUNDLES its UI (mobile-shell/) instead of loading the hosted
# /app over the network. The bundled client runs on capacitor://localhost, so it
# calls the platform with an ABSOLUTE origin. Default is the production apex; set
# this to point a preview build / self-host at a different backend. On the WEB
# this is ignored (the web /app stays same-origin). Build-time inlined, so set it
# in the build env BEFORE `npx cap sync`.
NEXT_PUBLIC_GS_API_BASE="https://greekstack.vercel.app"
# Optional EXTRA native origin to allow past CORS + the same-origin CSRF check on
# /api/mobile/* (e.g. a custom URL scheme). The standard Capacitor origins
# (capacitor://localhost, ionic://localhost, http://localhost) are always allowed.
# Leave unset unless you ship a custom scheme.
NEXT_PUBLIC_GS_NATIVE_ORIGIN=""

# ─── Site URL ───────────────────────────────────────────────
# The platform apex (marketing). Used for absolute links in emails / invites and
# as the neutral OG fallback. Per-chapter sites derive their own URL from the
# request Host, so this is never a chapter host.
NEXT_PUBLIC_SITE_URL="https://greekstack.vercel.app"
SITE_URL="https://greekstack.vercel.app"

# ─── iOS / TestFlight ───────────────────────────────────────
# The public TestFlight invite link for the companion iOS app. Owner-gated:
# only exists once the build is live in App Store Connect / TestFlight. When set
# to a real https://testflight.apple.com/join/<code> URL, the /ios page lights up
# its "Install via TestFlight" CTAs. When unset (or still containing the word
# "placeholder"), /ios shows an honest "coming soon" state instead of a dead link.
NEXT_PUBLIC_TESTFLIGHT_URL=""

# ─── Email (Resend) ─────────────────────────────────────────
# Platform-wide FALLBACK creds. Per-chapter overrides can be set in
# /admin/settings (resend.apiKey / resend.fromEmail) and win when present.
# Without any key, email runs in mock mode (logs only). RESEND_FROM is used by
# the invite routes; RESEND_FROM_EMAIL by everything else.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="rush@yourchapter.com"
RESEND_FROM="Your Chapter <onboarding@yourchapter.com>"

# ─── Support / sales contact ────────────────────────────────
# The address PROSPECTS + members see on the marketing funnel, legal pages,
# support page, onboarding CTAs, and platform invoices. Without any of these,
# everything defaults to workbenjaminsachwitz@gmail.com (the owner inbox).
#   NEXT_PUBLIC_SUPPORT_EMAIL  — public "email us" address (inlined at build)
#   SALES_CONTACT_EMAIL        — server-side inbox sales-form submissions deliver to
#   SUPPORT_CONTACT_EMAIL      — overrides the address stamped on invoices
# Set NEXT_PUBLIC_SUPPORT_EMAIL on Vercel to repoint the public-facing address.
NEXT_PUBLIC_SUPPORT_EMAIL="workbenjaminsachwitz@gmail.com"
SALES_CONTACT_EMAIL="workbenjaminsachwitz@gmail.com"
SUPPORT_CONTACT_EMAIL="workbenjaminsachwitz@gmail.com"

# ─── SMS (Twilio) ───────────────────────────────────────────
# Platform-wide FALLBACK creds. Per-chapter overrides in /admin/settings
# (twilio.accountSid / twilio.authToken / twilio.phoneNumber) win when present.
# Without these, SMS runs in mock mode (logs only).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+18035551234"

# ─── Payments (Stripe) — dues + alumni donations ────────────
# One shared platform Stripe account. REQUIRED for dues/donation checkout;
# without it getStripe() returns null and the payment buttons degrade gracefully
# ("payments not configured"). Use sk_test_… until you go live.
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret (whsec_…) for the SINGLE platform webhook endpoint
# https://<apex>/api/dues/webhook . The webhook verifies against this, then
# routes each event to the correct chapter schema via the checkout-session
# metadata.subdomain. (Legacy fallback: if STRIPE_WEBHOOK_SECRET is unset, each
# chapter's dues.stripeWebhookSecret config value is used instead — that path
# requires a per-chapter webhook URL and is not recommended.)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Platform billing (Stripe) — the chapter PAYING Greekstack ──────────────
# SEPARATE from the dues block above (chapters collecting from their own members)
# and from Stripe Connect. This is each chapter's recurring SUBSCRIPTION to the
# platform, billed on the same shared STRIPE_SECRET_KEY account. All optional —
# without them getStripe() degrades gracefully and the /admin/billing page shows
# a "contact support" state (the app never hard-blocks; the operator isActive
# flag is the only hard switch).
#
# (1) Dedicated signing secret for the PLATFORM webhook endpoint
#     https://<apex>/api/platform/billing/webhook . Point a SECOND Stripe webhook
#     (events: customer.subscription.created/updated/deleted, invoice.paid,
#     invoice.payment_failed, checkout.session.completed) at that URL and paste
#     its whsec_… here. If unset, the platform webhook FALLS BACK to
#     STRIPE_WEBHOOK_SECRET (fine for a single-endpoint setup, but a dedicated
#     secret keeps dues + platform events cleanly separated).
STRIPE_PLATFORM_WEBHOOK_SECRET="whsec_..."
# (2) Optional recurring Price id (price_…) for the $29/mo "chapter" plan. If
#     unset, checkout uses inline price_data ($29.00/mo USD) so billing works
#     without pre-creating a Price object in the Stripe dashboard.
STRIPE_PLATFORM_PRICE_ID=""

# ─── Headshot storage (Vercel Blob) — optional ──────────────
# Auto-injected by Vercel when you create a Blob store. Without it,
# /api/upload-headshot falls back to data URLs (works locally only).
BLOB_READ_WRITE_TOKEN=""

# ─── Image storage + delivery (Cloudinary) — optional ───────
# Fully additive. When ALL THREE server vars are set, image uploads
# (/api/upload-headshot, /api/upload-photo) go to Cloudinary under a
# per-tenant folder (greekstack/<subdomain>/...) and headshots/photos are
# delivered through Cloudinary's auto-format/auto-quality (face-cropped for
# avatars) transform CDN. When UNSET, the app behaves EXACTLY as before —
# uploads use Vercel Blob (or the data-URL mock) and all delivery is unchanged.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public cloud name (only needed if a client-side <CldImage> is ever added;
# server delivery uses CLOUDINARY_CLOUD_NAME). Safe to leave blank.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# ─── Auto-enrichment (Tavily) — optional ────────────────────
# Free key at https://app.tavily.com . Without it, /api/admin/enrich returns
# quick search links instead of auto-pulled data.
TAVILY_API_KEY=""

# ─── Cron auth ──────────────────────────────────────────────
# Gates /api/cron/* (scheduled announcements, log cleanup, Stripe reconcile).
# Vercel injects this as the Authorization bearer for scheduled crons. Match the
# value in Vercel → Settings → Environment Variables → CRON_SECRET.
CRON_SECRET="long-random-string-min-32-chars-zzzzzzzzzzzzzzzz"

# ─── Google Calendar bridge — optional ──────────────────────
# OAuth 2.0 client for /api/google-calendar/*. Authorized redirect URI must
# match GOOGLE_REDIRECT_URI. Degrades to a 503 "Connect" prompt when unset.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://greekstack.vercel.app/api/google-calendar/callback"

# ─── Error tracking (Sentry) — optional, per-tenant observability ──────────────
# FULLY INERT unless a DSN is set: with both blank, no Sentry code runs, the
# Next config is not wrapped, and the CSP is unchanged. Set these in Vercel only.
# Every captured error is tagged with the chapter `tenant` (subdomain) so issues
# across N chapters are attributable. SENTRY_DSN = server/edge (private);
# NEXT_PUBLIC_SENTRY_DSN = browser (shipped to client — use the same project DSN).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Optional sampling overrides (defaults: traces 0.1, replay off).
SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=""
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR=""
# Source-map upload (optional — errors report fine without these, but frames
# stay minified). Needs an auth token + org/project slugs.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Live-chat support (Chatwoot) — optional, free self-hostable support desk ──
# Adds a floating live-chat bubble so chapter officers can answer recruit +
# member questions in real time, powered by Chatwoot (MIT-core, self-hostable —
# no paid SaaS). FULLY INERT by default: with EITHER var blank, no widget script
# is emitted, no SDK loads, and the page is byte-identical to before. The
# launcher is auto-tinted to the chapter's brand color.
#   1. Stand up a Chatwoot install (Docker/Coolify) → its origin is the base URL.
#   2. Create a "Website" inbox; copy its Website Token from the inbox settings.
# Both values are PUBLISHABLE (they ship in the public widget snippet on every
# Chatwoot site) and are validated before rendering, so they're safe in client
# HTML — but keep them in env, never committed inline. NEXT_PUBLIC_ aliases work
# too if you prefer the Next-public convention.
CHATWOOT_BASE_URL=""
CHATWOOT_WEBSITE_TOKEN=""
