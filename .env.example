# ─── Database (Postgres) ────────────────────────────────────
# In production use Vercel Postgres / Neon. The Vercel Postgres integration
# auto-injects DATABASE_URL and DIRECT_URL when you connect a database.
# For local dev, you can run a Postgres container or point at a hosted DB.
DATABASE_URL="postgres://user:pass@localhost:5432/phisig"
DIRECT_URL="postgres://user:pass@localhost:5432/phisig"

# ─── Auth ───────────────────────────────────────────────────
# Single shared password the chapter uses to sign in
ADMIN_PASSWORD="changeme-strong-password"
ADMIN_SESSION_SECRET="long-random-string-min-32-chars-aaaaaaaaaaaaaaaa"

# ─── Email (Resend) ─────────────────────────────────────────
# Get a key at https://resend.com/api-keys
# Without these, /api/send-email runs in mock mode (logs only).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="rush@phisig-usc.com"

# ─── SMS (Twilio) ───────────────────────────────────────────
# Get creds at https://console.twilio.com
# Without these, /api/send-sms runs in mock mode (logs only).
TWILIO_ACCOUNT_SID="AC_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+18035551234"

# ─── Headshot storage (Vercel Blob) ─────────────────────────
# Auto-injected by Vercel when you create a Blob store in Project → Storage.
# Without it, /api/upload-headshot falls back to data URLs (works locally only).
BLOB_READ_WRITE_TOKEN=""

# ─── Auto-enrichment (Tavily) ───────────────────────────────
# Get a free key at https://app.tavily.com (1,000 free searches/mo)
# Without it, /api/admin/enrich returns quick search links instead of auto-pulled data.
TAVILY_API_KEY=""

# ─── Misc ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://phisigmakappa.vercel.app"
