// Phi Sigma Kappa @ USC — Rush Management
// Production target: Vercel Postgres / Neon. Schema is dialect-agnostic and works
// with sqlite locally if you swap the provider to "sqlite".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// RushStatus values stored as String (SQLite has no native enums):
// ACTIVE | DROPPED | BID_EXTENDED | ACCEPTED | DECLINED

model Rush {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String
  hometown        String?
  major           String?
  year            String?
  highSchoolInfo  String?
  backgroundInfo  String?
  headshotUrl     String?
  enrichmentData  String?   // JSON blob with auto-researched info (LinkedIn, IG, etc.)
  enrichedAt      DateTime?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailLogs       EmailLog[]
  smsLogs         SmsLog[]
  attendances     Attendance[]
  votes           Vote[]
  consents        RushConsent[]
}

// Rate-limit log for /api/rush. Each row = one submit attempt. Indexed on
// (ipAddress, createdAt) so the 60-minute window check is fast. Rows are
// short-lived; a periodic cleanup job (or a TTL) can prune older than 24h.
model RushSubmitLog {
  id          String   @id @default(cuid())
  ipAddress   String?
  email       String?
  status      String   // "ACCEPTED" | "RATE_LIMITED" | "INVALID"
  createdAt   DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// TCPA-grade consent receipt: snapshots the EXACT disclosure text + timestamp
// + IP + user-agent at the moment of submission, plus a double-opt-in confirm
// flag. We retain these for 4 years (TCPA recordkeeping).
model RushConsent {
  id              String    @id @default(cuid())
  rushId          String
  disclosureVersion String              // e.g. "2026-05-04" — bumps when the legal copy changes
  disclosureText  String              // verbatim copy shown to user at consent time
  ipAddress       String?
  userAgent       String?
  ageAttestation  String              // "ADULT_18_PLUS" | "MINOR_17_WITH_GUARDIAN_PERMISSION"
  smsConfirmed    Boolean  @default(false)   // true once user replies YES to confirmation SMS
  smsConfirmedAt  DateTime?
  optedOut        Boolean  @default(false)   // true once STOP / opt-out received
  optedOutAt      DateTime?
  createdAt       DateTime @default(now())

  rush            Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
}

model Event {
  id          String       @id @default(cuid())
  name        String
  description String?
  location    String?
  dressCode   String?
  startsAt    DateTime
  endsAt      DateTime?
  isPrivate   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  attendances Attendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  rushId    String
  eventId   String
  attended  Boolean  @default(true)
  createdAt DateTime @default(now())

  rush      Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([rushId, eventId])
}

model Brother {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  phone     String?
  year      String?           // Freshman | Sophomore | Junior | Senior
  major     String?
  position  String?           // President, VP, Treasurer, Rush Chair, etc.
  pledgeClass String?         // e.g. "Alpha Phi" — pledge class name
  bio       String?
  headshotUrl String?
  duesPaid  Boolean  @default(false)
  serviceHours Int   @default(0)
  studyHours Int    @default(0)
  role      String   @default("MEMBER")  // MEMBER | ADMIN
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  lastSeen  DateTime @default(now())

  votes     Vote[]
  announcements Announcement[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL")  // ALL | BROTHERS | RUSHES | EBOARD
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  author    Brother? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model BrotherInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  phone       String?
  prefillName String?
  invitedBy   String?   // sender brother name
  status      String    @default("PENDING") // PENDING | COMPLETED | EXPIRED | REVOKED
  brotherId   String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String   // Vercel Blob URL
  category    String   @default("GENERAL")  // BYLAWS | CALENDAR | DUES | RITUAL | GENERAL
  size        Int?
  createdAt   DateTime @default(now())
}

// Key/value site settings the chapter can tweak without a code deploy:
//  hero.tile1.slug | hero.tile1.caption | hero.tile1.icon
//  hero.tile2.slug | hero.tile2.caption | hero.tile2.icon
//  hero.tile3.slug | hero.tile3.caption | hero.tile3.icon
//  spotlight.slug | spotlight.name | spotlight.role | spotlight.month
//  about.slug | hero.tagline | ... etc.
model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Vote {
  id        String   @id @default(cuid())
  rushId    String
  brotherId String
  value     Int      // -2 strong no, -1 no, 0 neutral, 1 yes, 2 strong yes
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  rush      Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
  brother   Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)

  @@unique([rushId, brotherId])
}

model EmailLog {
  id         String   @id @default(cuid())
  rushId     String?
  subject    String
  body       String
  recipients String
  sentAt     DateTime @default(now())
  status     String   @default("SENT")

  rush       Rush?    @relation(fields: [rushId], references: [id], onDelete: SetNull)
}

model SmsLog {
  id         String   @id @default(cuid())
  rushId     String?
  body       String
  recipients String
  sentAt     DateTime @default(now())
  status     String   @default("SENT")

  rush       Rush?    @relation(fields: [rushId], references: [id], onDelete: SetNull)
}
