// Phi Sigma Kappa @ USC — Rush Management
// Production target: Vercel Postgres / Neon. Schema is dialect-agnostic and works
// with sqlite locally if you swap the provider to "sqlite".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// RushStatus values stored as String (SQLite has no native enums):
// ACTIVE | DROPPED | BID_EXTENDED | ACCEPTED | DECLINED

model Rush {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  phone           String
  hometown        String?
  major           String?
  year            String?
  highSchoolInfo  String?
  backgroundInfo  String?
  headshotUrl     String?
  enrichmentData  String?   // JSON blob with auto-researched info (LinkedIn, IG, etc.)
  enrichedAt      DateTime?
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // ── Bid response workflow ──────────────────────────────────────────────
  // Generated when admin sets status to BID_EXTENDED. PNM gets the URL
  // `/bid/{bidToken}` by email + SMS and clicks one button to accept or
  // decline — status auto-updates, no manual admin follow-up needed.
  //
  // Token is single-use: cleared after first response so a forwarded link
  // can't be replayed. Expiry is 14 days — bid windows shouldn't drag
  // longer than that, and uncollected tokens auto-expire instead of
  // hanging around forever as a phishing surface.
  bidToken           String?   @unique
  bidTokenExpiresAt  DateTime?
  bidRespondedAt     DateTime?
  bidResponseChoice  String?   // "ACCEPTED" | "DECLINED"

  emailLogs       EmailLog[]
  smsLogs         SmsLog[]
  attendances     Attendance[]
  votes           Vote[]
  consents        RushConsent[]
}

// Rate-limit log for /api/rush. Each row = one submit attempt. Indexed on
// (ipAddress, createdAt) so the 60-minute window check is fast. Rows are
// short-lived; a periodic cleanup job (or a TTL) can prune older than 24h.
model RushSubmitLog {
  id          String   @id @default(cuid())
  ipAddress   String?
  email       String?
  status      String   // "ACCEPTED" | "RATE_LIMITED" | "INVALID"
  createdAt   DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// TCPA-grade consent receipt: snapshots the EXACT disclosure text + timestamp
// + IP + user-agent at the moment of submission, plus a double-opt-in confirm
// flag. We retain these for 4 years (TCPA recordkeeping).
model RushConsent {
  id              String    @id @default(cuid())
  rushId          String
  disclosureVersion String              // e.g. "2026-05-04" — bumps when the legal copy changes
  disclosureText  String              // verbatim copy shown to user at consent time
  ipAddress       String?
  userAgent       String?
  ageAttestation  String              // "ADULT_18_PLUS" | "MINOR_17_WITH_GUARDIAN_PERMISSION"
  smsConfirmed    Boolean  @default(false)   // true once user replies YES to confirmation SMS
  smsConfirmedAt  DateTime?
  optedOut        Boolean  @default(false)   // true once STOP / opt-out received
  optedOutAt      DateTime?
  createdAt       DateTime @default(now())

  rush            Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
}

model Event {
  id          String       @id @default(cuid())
  name        String
  description String?
  location    String?
  dressCode   String?
  startsAt    DateTime
  endsAt      DateTime?
  isPrivate   Boolean      @default(false)
  // Event category — drives color/icon on the brother-facing calendar and
  // lets the e-board filter at a glance. Stored as a String (no native enum
  // in SQLite when used for local dev). Allowed values:
  //   RUSH        — open rush events, philanthropy, public-facing
  //   DATE        — date events, formals with dates
  //   BROTHERHOOD — internal brotherhood-only events, retreats
  //   CHAPTER     — required chapter meetings, ritual, business
  //   SOCIAL      — non-required social, mixers, parties
  //   OTHER       — fallback for events that don't fit cleanly above
  category    String       @default("OTHER")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  attendances Attendance[]
  rsvps       BrotherRSVP[]
}

// Per-brother RSVP for each Event. Brothers can RSVP "going / not going /
// maybe" so the e-board has a real headcount and the chapter can see who's
// committed. Composite unique on (eventId, brotherId) means each brother
// has at most one RSVP per event — `update` semantics on re-submit.
model BrotherRSVP {
  id        String   @id @default(cuid())
  eventId   String
  brotherId String
  // GOING | NOT_GOING | MAYBE — string for SQLite-portability.
  status    String
  note      String?  // optional one-liner ("driving from class, will be 5min late")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  brother   Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)

  @@unique([eventId, brotherId])
  @@index([eventId, status])
}

model Attendance {
  id        String   @id @default(cuid())
  rushId    String
  eventId   String
  attended  Boolean  @default(true)
  createdAt DateTime @default(now())

  rush      Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([rushId, eventId])
}

model Brother {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  phone     String?
  year      String?           // Freshman | Sophomore | Junior | Senior
  major     String?
  position  String?           // President, VP, Treasurer, Rush Chair, etc.
  pledgeClass String?         // e.g. "Alpha Phi" — pledge class name
  bio       String?
  headshotUrl String?
  duesPaid  Boolean  @default(false)
  serviceHours Int   @default(0)
  studyHours Int    @default(0)
  role      String   @default("MEMBER")  // MEMBER | ADMIN
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  lastSeen  DateTime @default(now())

  votes     Vote[]
  announcements Announcement[]
  rsvps     BrotherRSVP[]
  pollsCreated Poll[] @relation("createdBy")
  pollVotes PollVote[]
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL")  // ALL | BROTHERS | RUSHES | EBOARD
  pinned    Boolean  @default(false)
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  author    Brother? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model BrotherInvite {
  id          String    @id @default(cuid())
  token       String    @unique
  email       String?
  phone       String?
  prefillName String?
  invitedBy   String?   // sender brother name
  status      String    @default("PENDING") // PENDING | COMPLETED | EXPIRED | REVOKED
  brotherId   String?   @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  url         String   // Vercel Blob URL
  category    String   @default("GENERAL")  // BYLAWS | CALENDAR | DUES | RITUAL | GENERAL
  size        Int?
  createdAt   DateTime @default(now())
}

// Key/value site settings the chapter can tweak without a code deploy:
//  hero.tile1.slug | hero.tile1.caption | hero.tile1.icon
//  hero.tile2.slug | hero.tile2.caption | hero.tile2.icon
//  hero.tile3.slug | hero.tile3.caption | hero.tile3.icon
//  spotlight.slug | spotlight.name | spotlight.role | spotlight.month
//  about.slug | hero.tagline | ... etc.
model SiteConfig {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

model Vote {
  id        String   @id @default(cuid())
  rushId    String
  brotherId String
  value     Int      // -2 strong no, -1 no, 0 neutral, 1 yes, 2 strong yes
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  rush      Rush     @relation(fields: [rushId], references: [id], onDelete: Cascade)
  brother   Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)

  @@unique([rushId, brotherId])
}

model EmailLog {
  id         String   @id @default(cuid())
  rushId     String?
  subject    String
  body       String
  recipients String
  sentAt     DateTime @default(now())
  status     String   @default("SENT")

  rush       Rush?    @relation(fields: [rushId], references: [id], onDelete: SetNull)
}

model SmsLog {
  id         String   @id @default(cuid())
  rushId     String?
  body       String
  recipients String
  sentAt     DateTime @default(now())
  status     String   @default("SENT")

  rush       Rush?    @relation(fields: [rushId], references: [id], onDelete: SetNull)
}

// Quick chapter polls. Any logged-in brother (member or admin) can spin one
// up to take the chapter's pulse — "When should we host the next mixer?",
// "What philanthropy do we want next semester?", etc. Vote tallies are
// aggregate-only (we never expose who voted for what), enforced by the API
// layer; the underlying PollVote table records (pollId, brotherId, optionId)
// purely so each brother gets exactly one vote and can change it.
//
// Options are stored as a JSON-encoded String (works on both Postgres and
// SQLite without a separate row-per-option table). Shape is:
//   [{ id: "cuid...", label: "Option text" }, ...]
// Server is the source of truth for option ids — it generates them at create
// time and never mutates them so vote rows stay valid.
model Poll {
  id          String     @id @default(cuid())
  question    String     // <= 280 chars enforced at API layer
  options     String     // JSON: [{id, label}]
  createdById String
  closesAt    DateTime?  // optional auto-close timestamp
  closedAt    DateTime?  // set when manually closed by creator/admin
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  createdBy   Brother    @relation("createdBy", fields: [createdById], references: [id], onDelete: Cascade)
  votes       PollVote[]

  @@index([createdAt])
  @@index([closedAt])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  brotherId String
  optionId  String   // matches an entry in Poll.options
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  brother   Brother  @relation(fields: [brotherId], references: [id], onDelete: Cascade)

  @@unique([pollId, brotherId])
  @@index([pollId])
}

// AuditLog — chapter governance trail. Every PNM status change, vote change,
// dues toggle, brother deletion, broadcast, and settings change writes one
// row here so the e-board can answer "who changed what, when" months later.
//
// Intentionally NOT linked via FK to actor/subject — we want the row to
// outlive the actor (a brother who left the chapter) and the subject
// (a deleted PNM). Names + IDs are denormalized for retrieval forensics.
//
// Retained for 1 year (cron-pruned). TCPA / risk-management value > storage.
model AuditLog {
  id          String   @id @default(cuid())
  // Who: brother who triggered the action ("admin" for shared-creds admin)
  actorId     String?  // null for shared-admin session (no per-person brother row)
  actorName   String   // denormalized — survives actor deletion
  // What: short code (RUSH_STATUS, RUSH_VOTE, BROTHER_DUES, BROADCAST_SENT, etc.)
  action      String
  // Subject: the entity being acted on
  subjectType String   // "Rush" | "Brother" | "Event" | "Announcement" | "Settings"
  subjectId   String?  // ID of the row touched (nullable for bulk ops)
  subjectName String?  // denormalized name for retrieval (PNM name, brother name)
  // Detail: before → after, formatted for human reading at retrieval time
  details     String?  // e.g. "ACTIVE → BID_EXTENDED" or "vote: +1 → +2"
  // Context
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([subjectType, subjectId])
  @@index([actorId])
}
